{
  "name": "the-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "predev": "node scripts/pack-extension.js && node scripts/copy-pdf-assets.js",
    "build": "node scripts/pack-extension.js && node scripts/copy-pdf-assets.js && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "node-ical": "0.27.6",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7"
  }
}
