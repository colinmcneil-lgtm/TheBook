# Port the app listens on (default 3000)
PORT=3000
# Where the database and uploaded résumés are stored. Must be on a persistent disk in production.
DATA_DIR=./data
# Optional: connect email so confirmations, invitations and rejections are actually delivered.
# Use the SMTP details from your email provider (Google Workspace, Microsoft 365, Postmark, Resend, ...).
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM="Your Agency <hiring@youragency.com>"
