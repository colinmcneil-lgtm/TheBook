# Copy this file to .env to use it (npm run dev / start / seed read .env if it exists),
# or set the same names as real environment variables on your host.

# Port the app listens on (default 3000)
PORT=3000
# Where the database, uploaded résumés and recorded calls are stored. Must be on a persistent disk in production.
DATA_DIR=./data
# Optional: AI drafting for job autofill. With a key, the job description and intake notes a recruiter provides are
# sent to Anthropic's API to draft the job and its recruiter brief (billed per use). Without one, a basic reader is used.
# ANTHROPIC_API_KEY=sk-ant-...
# AUTOFILL_MODEL=claude-opus-5-5
# The same key lets the Oracle write call notes and submission drafts from a call's transcript.
# ORACLE_MODEL=claude-opus-5-5

# Optional: transcription for the Oracle. With a key, the audio of each recorded or uploaded call is sent to Deepgram
# once, to be written out with the speakers told apart (billed per hour of audio). Every request asks Deepgram not to
# keep the audio or use it for training. Without a key, calls are still recorded and kept, and a transcript can be pasted in.
# DEEPGRAM_API_KEY=
# The language of the calls (default en).
# DEEPGRAM_LANGUAGE=en
# To have audio processed in the EU:
# DEEPGRAM_API_URL=https://api.eu.deepgram.com/v1/listen

# ---------- Phone calls (optional) ----------
# With a Twilio account, The Book has a phone number of its own: recruiters call candidates through it (from the app,
# or by ringing it from their own mobile), candidates who ring it are put through, and each call is recorded, written
# out and put on the candidate. Needs all three of these, and APP_URL below. See "Phone calls" in the README.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# The number you bought at Twilio:
# TWILIO_NUMBER=+16475550100
# Countries that may be called, as two-letter codes (default CA,US). Premium-rate numbers are always refused.
# PHONE_COUNTRIES=CA,US
# The notice the other person hears before a recorded call is connected. Default on. "off" plays none (the recruiter
# must then tell them); any other text replaces the wording. Keep it under ten seconds.
# PHONE_NOTICE=on
# What your phone shows when a caller is put through: The Book's number (default), or "caller" for their own number.
# PHONE_FORWARD_SHOWS=caller
# The most calls one person can place in an hour (default 30).
# PHONE_CALLS_PER_HOUR=30
# Which of Twilio's voices reads the prompts (optional).
# PHONE_VOICE=alice
# Phone calls need APP_URL (near the end of this file) to be the exact public https address of the workspace: Twilio
# signs every message it sends with the address it was sent to, and that signature is checked against APP_URL.
# ---------- end of phone calls ----------

# How many reverse proxies sit in front of the app (0 = reached directly, 1 = one proxy, 2 = proxy plus CDN).
# Railway, Render and Fly.io are detected automatically; set this on other hosts.
# TRUST_PROXY=1
# Optional: connect email so confirmations, invitations and rejections are actually delivered. Two ways:
#
# 1. Resend's web API. Use this on Railway, whose Hobby plan blocks SMTP. MAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_xxxxxxxx
#
# 2. Any SMTP server (Google Workspace, Microsoft 365, Postmark, ...). Ignored if RESEND_API_KEY is set.
# SMTP_URL=smtps://username:password@smtp.example.com:465
#
# MAIL_FROM="Your Agency <hiring@youragency.com>"
# With email connected, admins are also emailed when someone requests an account, and people are emailed when approved.
# The address of this workspace, used for links in those emails (detected automatically on Railway).
# APP_URL=https://hiring.youragency.com
